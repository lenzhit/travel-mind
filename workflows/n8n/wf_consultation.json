{
  "id": "travelmind-consultation",
  "name": "TravelMind - Consulta",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/internal/workflows/jobs/consultation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.WORKFLOW_INTERNAL_TOKEN }}"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": false,
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      },
      "id": "next",
      "name": "Call Next.js service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        560,
        350
      ],
      "retryOnFail": false,
      "notes": "Next.js autentica system, aplica reglas, persiste e impone idempotencia. No se reintentan automáticamente errores de negocio ni pagos."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "travelmind-consultation",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "event-webhook",
      "name": "Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "4bc1e1d0-41d8-5cb7-ac14-f741e55b8e6c",
      "position": [
        240,
        620
      ],
      "notes": "Solo loopback. El token se compara antes de usar la identidad system; el cuerpo contiene UUID sin PII."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "event-token-check",
              "leftValue": "={{ $json.headers['x-travelmind-event-token'] }}",
              "rightValue": "={{ $env.WORKFLOW_INTERNAL_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "event-auth",
      "name": "Check Event Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        430,
        620
      ],
      "notes": "Rama falsa termina sin invocar Next.js."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://host.docker.internal:3000/api/internal/workflows/events/' + $json.body.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.WORKFLOW_INTERNAL_TOKEN }}"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": false,
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      },
      "id": "event-callback",
      "name": "Process Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        620
      ],
      "retryOnFail": false,
      "notes": "Next.js reclama una vez, persiste resultado y limita reintentos. Un replay es idempotente."
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Call Next.js service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Call Next.js service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Event Webhook": {
      "main": [
        [
          {
            "node": "Check Event Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Event Token": {
      "main": [
        [
          {
            "node": "Process Event",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "meta": {
    "travelmind": "consultation: tarea local acotada; sin secretos, datos de viajero ni proveedor externo."
  }
}
