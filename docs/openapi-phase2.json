  "components": {
    "securitySchemes": {
      "VisitorCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "travelmind_visitor",
        "description": "Cookie HttpOnly creada por POST /api/visitor/session; 48 horas"
      }
    },
    "schemas": {
      "ChatInput": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "destinationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "travelers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "budgetMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "departureDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "QuoteInput": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "variantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "travelers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "departureDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "packageId",
          "travelers",
          "departureDate"
        ],
        "additionalProperties": false
      },
      "ChatResult": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "title": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "destination": {
                  "type": "string"
                },
                "durationDays": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "priceMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "currency": {
                  "type": "string",
                  "const": "USD"
                },
                "reason": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "title": {
                        "type": "string"
                      },
                      "uri": {
                        "type": "string"
                      },
                      "version": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "approvedAt": {
                        "type": "string"
                      },
                      "excerpt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "uri",
                      "version",
                      "approvedAt",
                      "excerpt"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title",
                "slug",
                "destination",
                "durationDays",
                "priceMinor",
                "currency",
                "reason",
                "sources"
              ],
              "additionalProperties": false
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "ollama",
              "deterministic"
            ]
          },
          "retrieval": {
            "type": "string",
            "enum": [
              "semantic",
              "catalog"
            ]
          },
          "preferences": {
            "type": "object",
            "properties": {
              "travelers": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "budgetMinor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "departureDate": {
                "type": "string"
              },
              "destinationId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "message",
          "recommendations",
          "questions",
          "mode",
          "retrieval",
          "preferences"
        ],
        "additionalProperties": false
      },
      "Quotation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "issued",
              "expired",
              "superseded"
            ]
          },
          "issuedAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "packageId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "packageTitle": {
            "type": "string"
          },
          "packageUpdatedAt": {
            "type": "string"
          },
          "variantId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "variantName": {
            "type": [
              "string",
              "null"
            ]
          },
          "departureDate": {
            "type": "string"
          },
          "travelers": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subtotalMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "taxesMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "feesMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "discountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "source": {
            "type": "string"
          },
          "pricingPolicy": {
            "type": "string"
          },
          "availability": {
            "type": "string",
            "const": "requires_reconfirmation"
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "inclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
