# ==============================================================================
# TravelMind — Configuración de Entorno Local (Presupuesto Cero / Modo Demo)
# ==============================================================================
# IMPORTANTE: No requiere tarjetas de crédito, cuentas comerciales ni servicios pagos.
# Todas las integraciones funcionan localmente o mediante adaptadores Mock.

# Entorno de ejecución (demo | test | production)
APP_MODE=demo

# Proveedor de IA (Ollama autoalojado localmente, licencia MIT / Apache-2.0)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modelos fijados en src/server/ai/ollama.ts: qwen2.5:1.5b-instruct-q4_1 y nomic-embed-text:v1.5.
# Su ausencia activa búsqueda de catálogo; no se descargan automáticamente.
AI_TIMEOUT_MS=25000
AI_CONTEXT_TOKENS=2048
AI_OUTPUT_TOKENS=160
AI_CONCURRENCY=2
AI_THREADS=4

# Base de datos transaccional y pgvector (instancia local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelmind?schema=public"

# Proveedores de integración turística y pagos (Mock local por defecto)
TRAVEL_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Notificaciones y mensajería (Simulado / Mailpit local)
EMAIL_PROVIDER=mailpit
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025
WHATSAPP_PROVIDER=mock

# Orquestación de flujos (n8n Community Edition autoalojado)
WORKFLOW_PROVIDER=n8n-local
N8N_WEBHOOK_URL=http://localhost:5678/webhook
# Token de identidad system para n8n; vacío mantiene deshabilitado el endpoint interno.
WORKFLOW_INTERNAL_TOKEN=
# Solo prueba de fallo del proveedor local. No activa ningún proveedor remoto.
MOCK_TRAVEL_BOOKING_FAILURE=false

# Servidor web Next.js
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

 # Roles del personal: pnpm account:role <usuario existente> <admin|approver|travel_agent>

